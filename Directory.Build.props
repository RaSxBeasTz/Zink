<Project>
  <PropertyGroup>
    <!-- Keep generated build files outside the OneDrive-synchronized project folder. -->
    <BaseOutputPath>$(TEMP)\ZinkBuild\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(TEMP)\ZinkBuild\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
