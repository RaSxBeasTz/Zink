<Page
    x:Class="Zink.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#D6000814">

    <Grid>
        <Image Source="ms-appx:///Assets/ZinkSplashPage.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <Border Width="76"
                Height="76"
                Margin="0,0,0,72"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="38"
                BorderBrush="#A838FF66"
                BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#7600040A"/>
            </Border.Background>

            <ProgressRing x:Name="SplashLoader"
                          IsActive="True"
                          Width="46"
                          Height="46"
                          Foreground="#38FF66"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
