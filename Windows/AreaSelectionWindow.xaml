<Window
    x:Class="Zink.AreaSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="SelectionSurface"
          Background="Transparent"
          PointerPressed="SelectionSurface_PointerPressed"
          PointerMoved="SelectionSurface_PointerMoved"
          PointerReleased="SelectionSurface_PointerReleased"
          KeyDown="SelectionSurface_KeyDown"
          IsTabStop="True">
        <Image x:Name="DesktopPreview" Stretch="Fill"/>
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="TopShade" Fill="#8F000000"/>
            <Rectangle x:Name="LeftShade" Fill="#8F000000"/>
            <Rectangle x:Name="RightShade" Fill="#8F000000"/>
            <Rectangle x:Name="BottomShade" Fill="#8F000000"/>
            <Rectangle x:Name="SelectionRectangle"
                       Visibility="Collapsed"
                       Fill="Transparent"
                       Stroke="#38FF66"
                       StrokeThickness="2"/>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,34,0,0" Padding="18,10" CornerRadius="14"
                Background="#E611222D" BorderBrush="#7038FF66" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8C6;" FontFamily="Segoe Fluent Icons" Foreground="#38FF66"/>
                <TextBlock Text="Drag to select an area • Esc to cancel"
                           Foreground="White" FontWeight="SemiBold"/>
                <TextBlock x:Name="SizeText" Foreground="#AFFFFFFF"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
