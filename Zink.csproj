    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>

    <!-- x86 + x64 + arm64 support (Store-complete) -->
    <Platforms>x86;x64;arm64</Platforms>

    <!-- Ensure restore generates assets for all targets -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Bundle .NET 10 runtime so users don't have to install it -->
    <SelfContained>true</SelfContained>

    <!-- Fix duplicate assembly attributes (e.g. AssemblyFileVersionAttribute) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- WinUI 3: keep trimming off (safer) -->
    <PublishTrimmed>false</PublishTrimmed>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en</DefaultLanguage>
    <AppxDefaultResourceQualifiers>Language=en</AppxDefaultResourceQualifiers>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
