  <Target Name="EnsureIntelVplPackages" BeforeTargets="BuildZinkIntelVplEncoder" Condition="'$(Platform)'=='x64' And !Exists('$(IntelVplDevelDir)lib\native\include\vpl\mfxvideo.h')">
    <MakeDir Directories="$(IntelVplPackageDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $base='$(IntelVplPackageDir)'; $ver='$(IntelVplVersion)'; $items=@('onevpl.devel.win-x64','onevpl.runtime.win-x64'); foreach($name in $items){ $dir=Join-Path $base ($name + '.' + $ver); if(Test-Path $dir){ continue }; $nupkg=Join-Path $base ($name + '.' + $ver + '.nupkg'); $zip=Join-Path $base ($name + '.' + $ver + '.zip'); Invoke-WebRequest -Uri ('https://www.nuget.org/api/v2/package/' + $name + '/' + $ver) -OutFile $nupkg; Copy-Item $nupkg $zip -Force; Expand-Archive -Path $zip -DestinationPath $dir -Force }&quot;" />
  </Target>

  <Target Name="BuildZinkIntelVplEncoder" BeforeTargets="Build" DependsOnTargets="EnsureIntelVplPackages" Condition="'$(Platform)'=='x64'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\x64\$(Configuration)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj\Native\IntelVplEncoder\$(Configuration)" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\IntelVplEncoder\build.cmd&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(Configuration)&quot; &quot;$(MSBuildProjectDirectory)\Native\IntelVplEncoder\packages\onevpl.devel.win-x64.$(IntelVplVersion)&quot;" />
    <ItemGroup>
      <_IntelVplOutput Include="$(MSBuildProjectDirectory)\x64\$(Configuration)\ZinkIntelVplEncoder.dll" />
      <_IntelVplOutput Include="$(IntelVplRuntimeDir)runtimes\win-x64\native\libvpl.dll" />
      <_IntelVplOutput Include="$(IntelVplRuntimeDir)runtimes\win-x64\native\libvplswref64.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_IntelVplOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_IntelVplOutput)'!=''" />
  </Target>

  <Target Name="EnsureNvencHeader" BeforeTargets="BuildZinkNvencEncoder" Condition="'$(Platform)'=='x64' And !Exists('$(MSBuildProjectDirectory)\Native\ZinkNvencEncoder\nvEncodeAPI.h')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/NVIDIA/video-sdk-samples/master/Samples/NvCodec/NvEncoder/nvEncodeAPI.h' -OutFile '$(MSBuildProjectDirectory)\Native\ZinkNvencEncoder\nvEncodeAPI.h'&quot;" />
  </Target>

  <Target Name="BuildZinkNvencEncoder" BeforeTargets="Build" DependsOnTargets="EnsureNvencHeader" Condition="'$(Platform)'=='x64'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\ZinkNvencEncoder\build.cmd&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(Configuration)&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\x64\$(Configuration)\ZinkNvencEncoder.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

