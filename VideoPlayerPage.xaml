<Page
    x:Class="Zink.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mediaX="using:Microsoft.UI.Xaml.Media"
    xmlns:local="using:Zink"
    RequestedTheme="Dark"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    PointerMoved="Page_PointerMoved">

    <Page.Resources>
        <SolidColorBrush x:Key="ControlPanelBackground" Color="#FF101820" />
        <SolidColorBrush x:Key="GlassButtonBackground" Color="#FF1E3946" />
        <SolidColorBrush x:Key="GlassAccentButtonBackground" Color="{ThemeResource SystemAccentColor}" />

        <SolidColorBrush x:Key="VideoPageBackgroundBrush" Color="#05080D" />
        <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#59FFFFFF" />
        <SolidColorBrush x:Key="GlassSubtleBorderBrush" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="GlassTextBrush" Color="#F4FAFF" />
        <SolidColorBrush x:Key="GlassMutedTextBrush" Color="#B9C8D4" />

        <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />

        <Style x:Key="GlassControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassSubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style
            x:Key="GlassPrimaryButtonStyle"
            BasedOn="{StaticResource GlassControlButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassAccentButtonBackground}" />
            <Setter Property="BorderBrush" Value="#90FFFFFF" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="VideoRoot"
        Background="{StaticResource VideoPageBackgroundBrush}"
        SizeChanged="VideoRoot_SizeChanged">
        <controls:MediaPlayerElement
            x:Name="mediaPlayerElement"
            AreTransportControlsEnabled="False"
            AutoPlay="False"
            IsHitTestVisible="False"
            Stretch="Uniform"
            RenderTransformOrigin="0.5,0.5">
            <controls:MediaPlayerElement.RenderTransform>
                <CompositeTransform x:Name="VideoSurfaceTransform" />
            </controls:MediaPlayerElement.RenderTransform>
        </controls:MediaPlayerElement>

        <Grid
            IsHitTestVisible="False"
            Opacity="0.86">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#76000000" Offset="0" />
                    <GradientStop Color="#10000000" Offset="0.32" />
                    <GradientStop Color="#00000000" Offset="0.52" />
                    <GradientStop Color="#88000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Border
            x:Name="VideoFormatBadge"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,28,28,0"
            Background="#CC101820"
            BorderBrush="{StaticResource GlassPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="VideoFormatBadgeText"
                Text="SDR"
                Foreground="{StaticResource GlassTextBrush}"
                FontSize="14"
                FontWeight="SemiBold" />
        </Border>

        <Border
            x:Name="VideoResolutionBadge"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,76,28,0"
            Background="#CC101820"
            BorderBrush="{StaticResource GlassPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,8"
            Visibility="Collapsed">
            <TextBlock
                x:Name="VideoResolutionBadgeText"
                Text="HD"
                Foreground="{StaticResource GlassTextBrush}"
                FontSize="14"
                FontWeight="SemiBold" />
        </Border>

        <Border
            x:Name="VideoInfoPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="360"
            Margin="0,24,24,118"
            Background="#F0101820"
            BorderBrush="{StaticResource GlassPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="18"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="Video info"
                        Foreground="{StaticResource GlassTextBrush}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <Button
                        Grid.Column="1"
                        Click="CloseVideoInfoButton_Click"
                        Content="Close"
                        Style="{StaticResource GlassControlButtonStyle}"
                        MinWidth="72"
                        Padding="12,6" />
                </Grid>

                <ScrollViewer Grid.Row="2">
                    <TextBlock
                        x:Name="VideoInfoTextBlock"
                        Text="No video metadata detected yet."
                        Foreground="{StaticResource GlassTextBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            x:Name="SubtitleOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="28,0,28,126"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Visibility="Collapsed">

            <TextBlock
                x:Name="SubtitleTextBlock"
                Text=""
                Foreground="{StaticResource GlassTextBrush}"
                FontSize="24"
                FontWeight="SemiBold"
                TextWrapping="WrapWholeWords"
                TextAlignment="Center"
                MaxWidth="1100" />
        </Border>

        <Border
            x:Name="ControlPanel"
            Background="{StaticResource ControlPanelBackground}"
            BorderBrush="{StaticResource GlassPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="18,16"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="24,0,24,24"
            MaxWidth="1220"
            PointerEntered="ControlPanel_PointerEntered"
            PointerExited="ControlPanel_PointerExited">

            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="14,8"
                    Background="#22000000"
                    BorderBrush="{StaticResource GlassSubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="CurrentTimeText"
                            Text="00:00"
                            Foreground="{StaticResource GlassMutedTextBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0" />

                        <Slider
                            x:Name="SeekSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            IsEnabled="False"
                            IsThumbToolTipEnabled="True"
                            ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                            ValueChanged="SeekSlider_ValueChanged"
                            VerticalAlignment="Center" />

                        <TextBlock
                            x:Name="TotalTimeText"
                            Grid.Column="2"
                            Text="00:00"
                            Foreground="{StaticResource GlassMutedTextBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">

                        <Button
                            Click="Rewind_Click"
                            Content="Rewind"
                            Style="{StaticResource GlassControlButtonStyle}" />

                        <Button
                            Click="Play_Click"
                            Style="{StaticResource GlassPrimaryButtonStyle}">
                            <TextBlock Text="Play" />
                        </Button>

                        <Button
                            Click="Pause_Click"
                            Content="Pause"
                            Style="{StaticResource GlassControlButtonStyle}" />

                        <Button
                            Click="Forward_Click"
                            Content="Forward"
                            Style="{StaticResource GlassControlButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">

                        <Button
                            x:Name="FullScreenButton"
                            Click="FullScreenButton_Click"
                            Style="{StaticResource GlassControlButtonStyle}">
                            <TextBlock
                                x:Name="FullScreenLabel"
                                Text="Fullscreen" />
                        </Button>

                        <Button
                            x:Name="AspectRatioButton"
                            Style="{StaticResource GlassControlButtonStyle}">
                            <TextBlock
                                x:Name="AspectRatioButtonLabel"
                                Text="Aspect ratio" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Original" Tag="Original" Click="AspectRatioMenuItem_Click" />
                                    <MenuFlyoutItem Text="16:9" Tag="16:9" Click="AspectRatioMenuItem_Click" />
                                    <MenuFlyoutItem Text="4:3" Tag="4:3" Click="AspectRatioMenuItem_Click" />
                                    <MenuFlyoutItem Text="21:9" Tag="21:9" Click="AspectRatioMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Fill screen" Tag="Fill" Click="AspectRatioMenuItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Click="Browse_Click"
                            Content="Browse files"
                            Style="{StaticResource GlassControlButtonStyle}" />

                        <Button
                            x:Name="SubtitlesButton"
                            Click="SubtitlesButton_Click"
                            Style="{StaticResource GlassControlButtonStyle}">
                            <TextBlock
                                x:Name="SubtitlesButtonLabel"
                                Text="Subtitles" />
                        </Button>

                        <Button
                            x:Name="TranslateAudioButton"
                            Click="TranslateAudioButton_Click"
                            Style="{StaticResource GlassControlButtonStyle}">
                            <TextBlock
                                x:Name="TranslateAudioButtonLabel"
                                Text="Translate audio" />
                        </Button>

                        <Button
                            x:Name="SoundButton"
                            Content="Sound"
                            Style="{StaticResource GlassControlButtonStyle}" />

                        <Button
                            x:Name="AudioInfoButton"
                            Click="AudioInfoButton_Click"
                            Content="Info"
                            Style="{StaticResource GlassControlButtonStyle}" />

                        <Button
                            x:Name="VideoInfoButton"
                            Click="VideoInfoButton_Click"
                            Content="Video info"
                            Style="{StaticResource GlassControlButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border
            x:Name="FullScreenAnimationOverlay"
            IsHitTestVisible="False"
            Opacity="0"
            Background="#000000"
            BorderBrush="#A8FFFFFF"
            BorderThickness="0"
            CornerRadius="0">
            <Border.RenderTransform>
                <CompositeTransform x:Name="FullScreenOverlayTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#22FFFFFF" Offset="0.48" />
                        <GradientStop Color="#006BDAFF" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

            </Grid>
        </Border>
    </Grid>
</Page>
