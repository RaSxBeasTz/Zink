<Page
    x:Class="Zink.Pages.Social.SocialLockedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <StackPanel Spacing="18"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <FontIcon Glyph="&#xE72E;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="48"
                      Width="64"
                      Height="64"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="Zink Social is currently locked"
                       FontSize="28"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="This feature is still being worked on, but it has not yet met the level we expect."
                       FontSize="17"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
