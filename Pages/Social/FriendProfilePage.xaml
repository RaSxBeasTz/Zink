<Page
    x:Class="Zink.Pages.Social.FriendProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#70062D38" Offset="0"/>
                <GradientStop Color="#780B4450" Offset="0.48"/>
                <GradientStop Color="#9000080B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="18">
                <Button HorizontalAlignment="Left"
                        Padding="16,0"
                        MinHeight="42"
                        CornerRadius="21"
                        Click="BackButton_Click"
                        Content="Back"/>

                <Border Padding="28"
                        CornerRadius="24"
                        Background="#B0141820"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="14">
                        <Grid Width="132" Height="132">
                            <Ellipse Fill="#263746"/>
                            <FontIcon Glyph="&#xE77B;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="52"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <Image x:Name="AvatarImage"
                                   Width="132"
                                   Height="132"
                                   Stretch="UniformToFill"/>
                        </Grid>
                        <TextBlock x:Name="DisplayNameText"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="UsernameText"
                                   Foreground="#B7C8D2DC"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Padding="22"
                        CornerRadius="24"
                        Background="#B0141820"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Friend details"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock x:Name="AddedText"
                                   Foreground="#B7C8D2DC"/>
                        <TextBlock x:Name="SignedUpText"
                                   Foreground="#B7C8D2DC"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
