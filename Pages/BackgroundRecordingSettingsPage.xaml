<Page
    x:Class="Zink.Pages.BackgroundRecordingSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="24" MaxWidth="820" HorizontalAlignment="Center">
            <Button Content="← Back" Click="BackButton_Click" HorizontalAlignment="Left"/>

            <StackPanel Spacing="6">
                <TextBlock Text="Background recording settings" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Choose the clip length, audio sources, track layout, and recording quality."
                           Opacity="0.72" TextWrapping="Wrap"/>
            </StackPanel>

            <Border CornerRadius="16" Padding="22" Background="#1AFFFFFF" BorderBrush="#3348E6C1" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Clip length" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="The hotkey and taskbar command will save this amount of recent gameplay."
                               Opacity="0.72" TextWrapping="Wrap"/>
                    <ComboBox x:Name="DurationComboBox"
                              Width="260"
                              HorizontalAlignment="Left"
                              SelectionChanged="DurationComboBox_SelectionChanged">
                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                        <ComboBoxItem Content="45 seconds" Tag="45"/>
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                        <ComboBoxItem Content="4 minutes" Tag="240"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                        <ComboBoxItem Content="7 minutes" Tag="420"/>
                        <ComboBoxItem Content="8 minutes" Tag="480"/>
                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border CornerRadius="16" Padding="22" Background="#1AFFFFFF" BorderBrush="#3348E6C1" BorderThickness="1">
                <StackPanel Spacing="18">
                    <TextBlock Text="Audio sources" FontSize="19" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Record desktop and game audio" FontWeight="SemiBold"/>
                            <TextBlock Text="Includes the game and other sounds playing through Windows, including voice chat."
                                       Opacity="0.72" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SystemAudioToggle"
                                      Grid.Column="1"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="SystemAudioToggle_Toggled"/>
                    </Grid>

                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Record your microphone" FontWeight="SemiBold"/>
                            <TextBlock Text="Off by default. Turn this on to include the selected Windows microphone."
                                       Opacity="0.72" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="MicrophoneToggle"
                                      Grid.Column="1"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="MicrophoneToggle_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border CornerRadius="16" Padding="22" Background="#1AFFFFFF" BorderBrush="#3348E6C1" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Separate audio tracks" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Keeps the normal combined track for sharing and adds optional isolated tracks for editing."
                                       Opacity="0.72" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SeparateTracksToggle"
                                      Grid.Column="1"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="SeparateTracksToggle_Toggled"/>
                    </Grid>

                    <StackPanel x:Name="SeparateTrackOptions" Spacing="12">
                        <CheckBox x:Name="DesktopTrackCheckBox"
                                  Content="Add a separate desktop/game audio track"
                                  Click="DesktopTrackCheckBox_Click"/>
                        <CheckBox x:Name="MicrophoneTrackCheckBox"
                                  Content="Add a separate microphone track"
                                  Click="MicrophoneTrackCheckBox_Click"/>
                        <TextBlock Text="The combined track remains the default so clips still have complete sound in ordinary players and when uploaded."
                                   Opacity="0.65" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="16" Padding="22" Background="#1AFFFFFF" BorderBrush="#3348E6C1" BorderThickness="1">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Audio quality" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="AAC-LC at 48 kHz stereo. Higher quality creates slightly larger files."
                                   Opacity="0.72" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox x:Name="AudioBitrateComboBox"
                              Grid.Column="1"
                              Width="190"
                              SelectionChanged="AudioBitrateComboBox_SelectionChanged">
                        <ComboBoxItem Content="High — 256 kbps" Tag="256"/>
                        <ComboBoxItem Content="Very high — 320 kbps" Tag="320"/>
                        <ComboBoxItem Content="Maximum — 384 kbps" Tag="384"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Opacity="0.8" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
