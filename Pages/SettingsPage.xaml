<Page
    x:Class="Zink.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#B0141820"/>
        <SolidColorBrush x:Key="GlassPanelStrongBrush" Color="#C2182530"/>
        <SolidColorBrush x:Key="GlassTileBrush" Color="#8F101820"/>
        <SolidColorBrush x:Key="GlassPanelBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B7C8D2DC"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#183947"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24556A"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#102A35"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#26183947"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7CBFEFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#A8D9FFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5AA4D6FF"/>
        <SolidColorBrush x:Key="ToggleOnBrush" Color="#195B47"/>
        <SolidColorBrush x:Key="ToggleOnBorderBrush" Color="#70F2BF"/>
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#742B37"/>
        <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#FF8AA0"/>

        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassPanelBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}"/>
        </Style>

        <Style x:Key="GlassSettingRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource GlassTileBrush}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#7CBFEFFF"/>
            <Setter Property="Background" Value="#183947"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlidingToggleStyle" TargetType="primitives:ToggleButton">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:ToggleButton">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid RequestedTheme="Dark">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#70062D38" Offset="0"/>
                <GradientStop Color="#780B4450" Offset="0.52"/>
                <GradientStop Color="#9000080B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="32"
                        Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Settings"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Control startup, replay capture, and app updates."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"/>
                </StackPanel>

                <Border Style="{StaticResource GlassPanelStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Language" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Zink follows your Windows language unless you choose another language here."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="App language" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LanguageStatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="LanguageSearchBox"
                                                 PlaceholderText="Search languages"
                                                 TextChanged="LanguageSearchBox_TextChanged"
                                                 KeyDown="LanguageSearchBox_KeyDown"/>
                                        <Button Grid.Column="1"
                                                Content="Search"
                                                Style="{StaticResource GlassButtonStyle}"
                                                Click="LanguageSearchButton_Click"/>
                                    </Grid>
                                    <ComboBox x:Name="LanguageComboBox" MinWidth="280"
                                              DisplayMemberPath="DisplayName" SelectionChanged="LanguageComboBox_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassPanelStyle}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Background"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Replay and startup controls stay saved on this device."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Run Zink in the background when Windows starts"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StartupStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="StartupToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="StartupToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="StartupToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="StartupToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StartupToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="StartupToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Background recording settings"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose how Zink records and saves activity in the background."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Open"
                                        Style="{StaticResource GlassButtonStyle}"
                                        VerticalAlignment="Center"
                                        Click="BackgroundRecordingSettingsButton_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Keep Zink on for background notifications"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BackgroundNotificationsStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="BackgroundNotificationsToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="BackgroundNotificationsToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="BackgroundNotificationsToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="BackgroundNotificationsToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BackgroundNotificationsToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="BackgroundNotificationsToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Use low memory and CPU in the background"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LowResourceBackgroundStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="LowResourceBackgroundToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="LowResourceBackgroundToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="LowResourceBackgroundToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="LowResourceBackgroundToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LowResourceBackgroundToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LowResourceBackgroundToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Background replay for gaming"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BackgroundReplayStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="BackgroundReplayOffToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="BackgroundReplayOffToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="BackgroundReplayToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="BackgroundReplayToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BackgroundReplayToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="BackgroundReplayToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Game clip recording hotkey"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HotkeyClipRecordingStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="HotkeyClipRecordingToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="HotkeyClipRecordingToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="HotkeyClipRecordingToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="HotkeyClipRecordingToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HotkeyClipRecordingToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="HotkeyClipRecordingToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassPanelStyle}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Diagnostics"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Write Zink debug output to a local text file."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Diagnostic log file"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DiagnosticLogStatusText"
                                               Text=""
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <primitives:ToggleButton x:Name="DiagnosticLogToggle"
                                                         Grid.Column="1"
                                                         Style="{StaticResource SettingsSlidingToggleStyle}"
                                                         Click="DiagnosticLogToggle_Toggled">
                                    <Grid Width="128" Height="42">
                                        <Border x:Name="DiagnosticLogToggleTrack" CornerRadius="21" BorderThickness="1"/>
                                        <TextBlock x:Name="DiagnosticLogToggleOffLabel" Text="Off" Margin="46,0,14,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DiagnosticLogToggleOnLabel" Text="On" Margin="14,0,46,0" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border Width="34" Height="34" Margin="4" CornerRadius="17" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="DiagnosticLogToggleKnobTransform"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </primitives:ToggleButton>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="OpenDiagnosticLogFolderButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="OpenDiagnosticLogFolderButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE838;" FontSize="15"/>
                                    <TextBlock Text="Open log folder"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ClearDiagnosticLogButton"
                                    Grid.Column="1"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ClearDiagnosticLogButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                                    <TextBlock Text="Clear log"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="RunHealthCheckButton"
                                    Grid.Column="2"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="RunHealthCheckButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="15"/>
                                    <TextBlock Text="Run health check"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource GlassSettingRowStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Support report"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="HealthCheckStatusText"
                                               Text="Run a health check to create a report and support bundle."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <Button x:Name="OpenHealthReportButton"
                                        Grid.Column="1"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Click="OpenHealthReportButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="15"/>
                                        <TextBlock Text="Open report"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="UploadHealthReportButton"
                                        Grid.Column="2"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Click="UploadHealthReportButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE898;" FontSize="15"/>
                                        <TextBlock Text="Upload"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassPanelStyle}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Maintenance"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Restore this page back to the defaults or check for an app update"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ResetDefaultsButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ResetDefaultsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="15"/>
                                    <TextBlock Text="Reset defaults"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="CheckForUpdatesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="CheckForUpdatesButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="15"/>
                                    <TextBlock Text="Check for updates"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="StatusText"
                                   Text=""
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
