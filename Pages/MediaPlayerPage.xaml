<Page
    x:Class="Zink.MusicPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zink"
    Background="Transparent">

    <Page.Resources>
        <Color x:Key="ZinkAccentColor">#38FF66</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ZinkAccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F7FFFFFF"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#A8E7FFF6"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#38BCEEF2"/>
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#2419A7B5"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#3823C6D2"/>

        <AcrylicBrush x:Key="GlassPanelBrush"
                      TintColor="#071B25"
                      TintOpacity="0.80"
                      TintLuminosityOpacity="0.42"
                      FallbackColor="#F20B1D26"/>

        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ControlSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="TransportToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E4071720" Offset="0"/>
                <GradientStop Color="#D90A313B" Offset="0.48"/>
                <GradientStop Color="#F0040C12" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="620" Height="620"
                 Margin="-250,-330,0,0"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4022D7E5" Offset="0"/>
                    <GradientStop Color="#0011D8E8" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ZoomMode="Disabled">
            <Grid Padding="24" ColumnSpacing="16" MinHeight="680">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" MinWidth="220"/>
                    <ColumnDefinition Width="1.55*" MinWidth="360"/>
                    <ColumnDefinition Width="0.95*" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- Queue: same ListView and selection behavior, refreshed glass presentation. -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanelStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="Queue"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <FontIcon Glyph="&#xE8FD;"
                                      FontSize="18"
                                      Foreground="{StaticResource SubtleTextBrush}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <ListView Grid.Row="1"
                                  x:Name="QueueList"
                                  SelectionChanged="QueueList_SelectionChanged"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MusicTrack">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="14"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Title}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Height="1" Background="{StaticResource HairlineBrush}"/>
                    </Grid>
                </Border>

                <!-- Now Playing: all existing transport controls and event handlers are retained. -->
                <Border Grid.Column="1" Style="{StaticResource GlassPanelStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Now Playing"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Grid.Row="1" Spacing="7" VerticalAlignment="Center">
                            <Border Width="300" Height="300"
                                    Background="#A500080B"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                                <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock x:Name="TrackTitle"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TrackArtist"
                                       FontSize="16"
                                       Foreground="{StaticResource AccentBrush}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Unknown Album"
                                       FontSize="13"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <Slider x:Name="SeekSlider"
                                    Minimum="0"
                                    ValueChanged="SeekSlider_ValueChanged"
                                    Foreground="{StaticResource AccentBrush}"
                                    Background="#5CFFFFFF"/>

                            <ProgressBar x:Name="SongProgressBar"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Visibility="Collapsed"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#24FFFFFF"/>

                            <TextBlock x:Name="TimeDisplay"
                                       FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Text="00:00 / 00:00"
                                       HorizontalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="13"
                                        Margin="0,6,0,0">
                                <ToggleButton x:Name="ShuffleButton"
                                              Click="ShuffleButton_Click"
                                              Style="{StaticResource TransportToggleStyle}">
                                    <SymbolIcon Symbol="Shuffle"/>
                                </ToggleButton>

                                <Button Click="Previous_Click"
                                        Style="{StaticResource TransportButtonStyle}">
                                    <SymbolIcon Symbol="Back"/>
                                </Button>

                                <Button x:Name="PlayPauseButton"
                                        Click="PlayPause_Click"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="#FF001407"
                                        BorderBrush="#AAFFFFFF"
                                        BorderThickness="1"
                                        Width="60"
                                        Height="60"
                                        Padding="17"
                                        CornerRadius="30">
                                    <SymbolIcon Symbol="Play"/>
                                </Button>

                                <Button Click="Next_Click"
                                        Style="{StaticResource TransportButtonStyle}">
                                    <SymbolIcon Symbol="Forward"/>
                                </Button>

                                <ToggleButton x:Name="RepeatButton"
                                              Click="RepeatButton_Click"
                                              Style="{StaticResource TransportToggleStyle}">
                                    <SymbolIcon Symbol="RepeatAll"/>
                                </ToggleButton>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <SymbolIcon x:Name="VolumeIcon"
                                        Symbol="Volume"
                                        Foreground="{StaticResource TextBrush}"
                                        VerticalAlignment="Center"/>
                            <Slider Grid.Column="1"
                                    x:Name="VolumeSlider"
                                    MinWidth="90"
                                    Minimum="0"
                                    Maximum="1"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    SmallChange="0.05"
                                    LargeChange="0.1"
                                    Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Column="2"
                                       x:Name="VolumePercent"
                                       Text="50%"
                                       FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="3"
                                          x:Name="BackgroundPlaybackToggle"
                                          Content="Play in Background"
                                          IsChecked="False"
                                          Background="{StaticResource ControlSurfaceBrush}"
                                          Foreground="{StaticResource TextBrush}"
                                          BorderBrush="{StaticResource HairlineBrush}"
                                          BorderThickness="1"
                                          Padding="12,7"
                                          CornerRadius="14"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <MediaPlayerElement x:Name="Player"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Browse: same picker, selected-track binding and send action. -->
                <Border Grid.Column="2" Style="{StaticResource GlassPanelStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Browse"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <Button Grid.Row="1"
                                x:Name="BrowseFilesButton"
                                Click="BrowseFiles_Click"
                                Style="{StaticResource GlassButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                                <TextBlock Text="Browse Music Files"/>
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="2"
                                Background="#1800D6E8"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Selected Files"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           Margin="8,5"/>
                                <ListView Grid.Row="1"
                                          x:Name="SelectedFilesList"
                                          MinHeight="120"
                                          ItemsSource="{x:Bind _selectedTracks, Mode=OneWay}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="8,7"/>
                                            <Setter Property="CornerRadius" Value="7"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:MusicTrack">
                                            <Grid ColumnSpacing="9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE8D6;"
                                                          FontSize="13"
                                                          Foreground="{StaticResource AccentBrush}"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Button Grid.Row="3"
                                Content="Send to Player"
                                Click="SendToPlayer_Click"
                                Background="{StaticResource AccentBrush}"
                                Foreground="#FF001407"
                                BorderBrush="#99FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,11"
                                HorizontalAlignment="Stretch"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
