                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                        <TextBlock Text="Clear"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1"
                                    Style="{StaticResource GlassPanelStyle}"
                                    Padding="8"
                                    MaxHeight="330"
                                    Background="#73131D28">
                                <ListView x:Name="RecentList"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsItemClickEnabled="True"
                                          ItemClick="RecentList_ItemClick"
                                          SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="38" Height="38" CornerRadius="15" Background="#263846" BorderBrush="#24FFFFFF" BorderThickness="1">
                                                    <FontIcon Glyph="&#xE8D4;"
                                                              FontFamily="Segoe Fluent Icons"
                                                              Foreground="White"
                                                              FontSize="15"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RightText}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
