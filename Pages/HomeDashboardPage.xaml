<Page
    x:Class="Zink.Pages.HomeDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <AcrylicBrush x:Key="GlassPanelBrush"
                      TintColor="#031A24"
                      TintOpacity="0.62"
                      TintLuminosityOpacity="0.46"
                      FallbackColor="#D0031A24"/>
        <AcrylicBrush x:Key="GlassStrongBrush"
                      TintColor="#02141D"
                      TintOpacity="0.76"
                      TintLuminosityOpacity="0.40"
                      FallbackColor="#E802141D"/>
        <LinearGradientBrush x:Key="GlassTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9C021A24" Offset="0"/>
            <GradientStop Color="#78032935" Offset="0.5"/>
            <GradientStop Color="#58031320" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassTileHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B0063440" Offset="0"/>
            <GradientStop Color="#8A07505A" Offset="0.55"/>
            <GradientStop Color="#6811D8E8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassTilePressedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C0041119" Offset="0"/>
            <GradientStop Color="#9A06303A" Offset="0.55"/>
            <GradientStop Color="#7038FF66" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8078D9DD" Offset="0"/>
            <GradientStop Color="#50099AAB" Offset="0.45"/>
            <GradientStop Color="#4011D8E8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassBorderStrongBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B078D9DD" Offset="0"/>
            <GradientStop Color="#70099AAB" Offset="0.38"/>
            <GradientStop Color="#6011D8E8" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B7D6E2EA"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#83D6E2EA"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#5AE8E0"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#5AA7FF"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#7BF5B5"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#FFD56A"/>
        <SolidColorBrush x:Key="RedBrush" Color="#FF6F86"/>
        <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9C021A24" Offset="0"/>
            <GradientStop Color="#78032935" Offset="0.5"/>
            <GradientStop Color="#58031320" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B0063440" Offset="0"/>
            <GradientStop Color="#8A07505A" Offset="0.55"/>
            <GradientStop Color="#6811D8E8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C0041119" Offset="0"/>
            <GradientStop Color="#9A06303A" Offset="0.55"/>
            <GradientStop Color="#7038FF66" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#26183947"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
        <LinearGradientBrush x:Key="ButtonBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B078D9DD" Offset="0"/>
            <GradientStop Color="#70099AAB" Offset="0.38"/>
            <GradientStop Color="#6011D8E8" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B011D8E8"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A038FF66"/>

        <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
            <Border x:Name="GlassButtonRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="GlassButtonRoot.Background" Value="{StaticResource GlassTileHoverBrush}"/>
                                <Setter Target="GlassButtonRoot.BorderBrush" Value="{StaticResource ButtonBorderBrushPointerOver}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="GlassButtonRoot.Background" Value="{StaticResource GlassTilePressedBrush}"/>
                                <Setter Target="GlassButtonRoot.BorderBrush" Value="{StaticResource ButtonBorderBrushPressed}"/>
                                <Setter Target="GlassButtonRoot.Opacity" Value="0.92"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="GlassButtonRoot.Opacity" Value="0.42"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
        </ControlTemplate>

        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}"/>
        </Style>

        <Style x:Key="GlassTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="158"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassTileBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        </Style>

        <Style x:Key="GlassTileIconStyle" TargetType="FontIcon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassTileBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        </Style>

        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Background" Value="{StaticResource GlassTileHoverBrush}"/>
            <Setter Property="BorderBrush" Value="#B038FF66"/>
        </Style>

        <Style x:Key="ZinkSubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            <Setter Property="MaxLines" Value="2"/>
        </Style>

        <Style x:Key="SignalCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="{StaticResource GlassTileBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PulseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderStrongBrush}"/>
            <Setter Property="Background" Value="{StaticResource GlassTileBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        </Style>
    </Page.Resources>

    <Grid RequestedTheme="Dark" Background="Transparent">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="32"
                  RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="18"
                                    Background="#224FE8E0"
                                    BorderBrush="#785AE8E0"
                                    BorderThickness="1">
                                <FontIcon Glyph="&#xE768;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="24"
                                          Foreground="{StaticResource CyanBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="Zink"
                                           FontSize="42"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="Play. Watch. Call. Share. Tune. Test."
                                           FontSize="15"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                    <Button x:Name="NotificationsButton"
                            Grid.Column="1"
                            Width="54"
                            Height="54"
                            Padding="0"
                            CornerRadius="27"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GlassBorderStrongBrush}"
                            Background="#30FFFFFF"
                            Foreground="White"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="370"
                                        Padding="18"
                                        CornerRadius="26"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        Background="{StaticResource GlassStrongBrush}">
                                    <StackPanel Spacing="14">
                                        <Grid>
                                            <TextBlock Text="Notifications"
                                                       FontSize="21"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                            <TextBlock x:Name="NotificationsCountText"
                                                       Text="0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"/>
                                        </Grid>
                                        <ItemsControl x:Name="NotificationsList"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="28" Height="28">
                            <FontIcon Glyph="&#xE7F4;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="19"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            <Border x:Name="NotificationsBadge"
                                    Width="10"
                                    Height="10"
                                    CornerRadius="10"
                                    Background="{StaticResource RedBrush}"
                                    BorderBrush="#CCFFFFFF"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"/>
                        </Grid>
                    </Button>
                </Grid>

                <Grid x:Name="HeroInsightsSection"
                      Grid.Row="1"
                      ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="14">
                    <Border Style="{StaticResource GlassPanelStyle}"
                            Padding="14"
                            MaxHeight="330"
                            Background="{StaticResource GlassStrongBrush}">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#D64F95FF" CornerRadius="999" Padding="12,5">
                                    <TextBlock x:Name="HeroKindText"
                                               Text="Idle"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#24232D38" CornerRadius="999" Padding="12,5" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <TextBlock x:Name="HeroMetaText"
                                               Text="Nothing active"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="HeroTitle"
                                               Text="Your Zink session starts here"
                                               FontSize="28"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                    <TextBlock x:Name="HeroSubtitle"
                                               Text="Open your last media, keep Spotify visible, or jump into the spaces you use most."
                                               FontSize="15"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="WrapWholeWords"
                                               MaxLines="1"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="112"
                                        Height="112"
                                        CornerRadius="22"
                                        BorderBrush="#405AE8E0"
                                        BorderThickness="1"
                                        Background="#80131D28">
                                    <Grid>
                                        <Image x:Name="HeroThumb"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="HeroThumbFallback">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <Grid Width="56" Height="56">
                                                    <Ellipse Fill="#263846"/>
                                                    <Ellipse Stroke="#805AE8E0" StrokeThickness="1"/>
                                                    <FontIcon Glyph="&#xE768;"
                                                              FontFamily="Segoe Fluent Icons"
                                                              FontSize="24"
                                                              Foreground="{StaticResource CyanBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Live"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SignalCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Surface" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                                        <TextBlock x:Name="HeroTypeValue" Text="Nothing" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource SignalCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="State" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                                        <TextBlock x:Name="HeroPlaybackValue" Text="Stopped" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SignalCardStyle}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Time" Foreground="{StaticResource DimTextBrush}" FontSize="12"/>
                                        <TextBlock x:Name="HeroDurationValue" Text="-" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ResumeButton"
                                            Style="{StaticResource PrimaryPillButtonStyle}"
                                            IsEnabled="False"
                                            Click="ResumeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                            <TextBlock Text="Resume"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="ResetClearButton"
                                            Style="{StaticResource PillButtonStyle}"
                                            IsEnabled="False"
                                            Click="ResetClearButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                            <TextBlock Text="Reset / Clear"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PillButtonStyle}" Click="OpenFileButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                            <TextBlock Text="Open file"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PillButtonStyle}" Click="OpenFolderButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                            <TextBlock Text="Open folder"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel x:Name="SpotifyPlaybackControls"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Visibility="Collapsed">
                                        <Button Style="{StaticResource PillButtonStyle}"
                                                Click="SpotifyLikeButton_Click"
                                                ToolTipService.ToolTip="Add to Spotify Liked Songs">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8E1;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                                <TextBlock Text="Like"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource PillButtonStyle}"
                                                Click="SpotifyNextButton_Click"
                                                ToolTipService.ToolTip="Play the next Spotify track">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                                <TextBlock Text="Next"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource PillButtonStyle}"
                                                Click="SpotifyStopButton_Click"
                                                ToolTipService.ToolTip="Stop Spotify playback">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                                <TextBlock Text="Stop"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource PillButtonStyle}"
                                                Click="SpotifyDislikeButton_Click"
                                                ToolTipService.ToolTip="Remove from Spotify Liked Songs">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8E0;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                                                <TextBlock Text="Dislike"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <Border x:Name="HomeRadioVolumePanel"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        CornerRadius="22"
                                        Padding="14"
                                        Background="#4F131D28"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="&#xE15D;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  FontSize="18"
                                                  Foreground="White"
                                                  VerticalAlignment="Center"/>

                                        <Slider x:Name="HomeRadioVolumeSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="100"
                                                StepFrequency="1"
                                                Value="50"
                                                VerticalAlignment="Center"
                                                ValueChanged="HomeRadioVolumeSlider_ValueChanged"/>

                                        <TextBlock x:Name="HomeRadioVolumeValueText"
                                                   Grid.Column="2"
                                                   Text="50%"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="QuickStartSection"
                            Style="{StaticResource GlassPanelStyle}"
                            Padding="12"
                            Background="#64131D28">
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="QuickStartTitle"
                                           Text="Try this next"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="QuickStartSubtitle"
                                           Text="Pick a path that shows what makes Zink worth installing."
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource PillButtonStyle}"
                                    MinHeight="38"
                                    Padding="12,0"
                                    Click="ChangeQuickStartMode_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                    <TextBlock Text="Change mode"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                 <Button x:Name="QuickStartPrimaryButton"
                                        Style="{StaticResource PulseButtonStyle}"
                                         Width="150"
                                        Click="QuickStartPrimary_Click">
                                    <StackPanel Padding="11" Spacing="4">
                                        <FontIcon x:Name="QuickStartPrimaryIcon"
                                                  Glyph="&#xE7F6;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{StaticResource YellowBrush}"
                                                  FontSize="20"/>
                                        <TextBlock x:Name="QuickStartPrimaryTitle"
                                                   Text="Listen live"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="QuickStartPrimarySubtitle"
                                                   Text="Open radio"
                                                   Style="{StaticResource ZinkSubText}"/>
                                    </StackPanel>
                                </Button>

                                 <Button x:Name="QuickStartSecondaryButton"
                                        Style="{StaticResource PulseButtonStyle}"
                                         Width="150"
                                        Click="QuickStartSecondary_Click">
                                    <StackPanel Padding="11" Spacing="4">
                                        <FontIcon x:Name="QuickStartSecondaryIcon"
                                                  Glyph="&#xE722;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{StaticResource BlueBrush}"
                                                  FontSize="20"/>
                                        <TextBlock x:Name="QuickStartSecondaryTitle"
                                                   Text="Record"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="QuickStartSecondarySubtitle"
                                                   Text="Capture a clip"
                                                   Style="{StaticResource ZinkSubText}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="QuickStartThirdButton"
                                        Style="{StaticResource PulseButtonStyle}"
                                        Width="150"
                                        Click="QuickStartThird_Click">
                                    <StackPanel Padding="11" Spacing="4">
                                        <FontIcon x:Name="QuickStartThirdIcon"
                                                  Glyph="&#xE774;"
                                                  FontFamily="Segoe Fluent Icons"
                                                  Foreground="{StaticResource CyanBrush}"
                                                  FontSize="20"/>
                                        <TextBlock x:Name="QuickStartThirdTitle"
                                                   Text="Connect"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="QuickStartThirdSubtitle"
                                                   Text="Call or share"
                                                   Style="{StaticResource ZinkSubText}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="PowerToolsSection"
                          ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <Button x:Name="TileBtn_MusicPlayer" Style="{StaticResource GlassTileButtonStyle}" Click="MusicPlayer_Click">
                            <Grid Padding="16" RowSpacing="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <FontIcon Style="{StaticResource GlassTileIconStyle}" Glyph="&#xEC4F;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{StaticResource CyanBrush}"/>
