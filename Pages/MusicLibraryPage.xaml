<Page
    x:Class="Zink.Pages.MusicLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="White"/>
    </Page.Resources>

    <Grid>
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and actions match the Video Library page. -->
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Music Library"
                           FontSize="28"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="PickFolderButton"
                        Content="Add Music Folder"
                        Click="PickFolderButton_Click"/>
                <Button Content="Refresh"
                        Click="RefreshLibraryButton_Click"
                        ToolTipService.ToolTip="Reload songs and retry missing artwork"/>
                <Button Content="Open scan log"
                        Click="OpenScanLogButton_Click"
                        ToolTipService.ToolTip="Open the text log of song scans and filename changes"/>
                <Button x:Name="PlayAllButton"
                        Content="Play All"
                        Click="PlayAllButton_Click"/>
            </StackPanel>

            <TextBlock Text="{Binding PickedFolderPath}"
                       Opacity="0.7"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="Browse folders and preview the music inside before adding the folder to Zink."
                       Opacity="0.7"
                       FontSize="12"
                       TextWrapping="WrapWholeWords"/>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="LibraryStatusRing" Width="18" Height="18"
                              IsActive="False" Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryStatusText" Opacity="0.75" Text=""
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar x:Name="LibraryStatusProgressBar" Width="160" Height="6"
                             Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="LibraryStatusProgressText" Opacity="0.75" Text=""
                           MinWidth="36" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Search filters the displayed cards without changing the library or playback queue. -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,12">
            <AutoSuggestBox x:Name="MusicSearchBox"
                            PlaceholderText="Search by song name, artist, album, or filename"
                            QueryIcon="Find"
                            TextChanged="MusicSearchBox_TextChanged"
                            AutomationProperties.Name="Search music library"/>
            <TextBlock Text="{Binding SearchResultsText}" Opacity="0.7" FontSize="12"/>
        </StackPanel>

        <!-- Album-style cards mirror the Video Library thumbnail layout. -->
        <GridView Grid.Row="2"
                  ItemsSource="{Binding VisibleSongs}"
                  IsItemClickEnabled="False"
                  SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.VerticalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="180" Spacing="8">
                        <Border Height="180"
                                Background="#202020"
                                CornerRadius="12"
                                Tapped="SongArtwork_Tapped"
                                PointerEntered="SongArtwork_PointerEntered"
                                PointerExited="SongArtwork_PointerExited">
                            <Grid>
                                <FontIcon Glyph="&#xE8D6;"
                                          FontSize="88"
                                          Opacity="0.16"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                <StackPanel Padding="18"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                            FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Artist}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               Opacity="0.7"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Album}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               Opacity="0.55"
                                               FontSize="12"/>
                                </StackPanel>
                                <Rectangle RadiusX="12" RadiusY="12">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="{Binding Artwork}"
                                                    Stretch="UniformToFill"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Duration}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding Artist}"
                                   Opacity="0.7"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>

                        <Button Content="Play"
                                Click="PlaySongButton_Click"
                                DataContext="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>

        <Grid x:Name="MusicLibraryLoadingOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border MaxWidth="520" Margin="24" Padding="32,30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F2040F16" BorderBrush="#7A11D8E8"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel Spacing="14">
                    <ProgressRing x:Name="MusicLibraryLoadingRing" Width="52" Height="52"
                                  IsActive="False" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MusicLibraryLoadingText" Text="Loading music..."
                               FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="WrapWholeWords" Foreground="#F4FFFFFF"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <ProgressBar x:Name="MusicLibraryLoadingProgressBar" Width="260" Height="8"
                                     Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="MusicLibraryLoadingPercentage" Text="" MinWidth="42"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#BDE7FFF6"
                                   Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
