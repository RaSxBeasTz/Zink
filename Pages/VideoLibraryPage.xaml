<Page
    x:Class="Zink.Pages.VideoLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Zink.Pages"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="White"/>
    </Page.Resources>

    <Grid>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Header + actions -->
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Video Library" FontSize="28" FontWeight="SemiBold" />
                <Button x:Name="AddFolderButton" Content="Add Folder" Click="AddFolderButton_Click" />
                <Button x:Name="RescanButton" Content="Rescan" Click="RescanButton_Click" />
            </StackPanel>

            <!-- ? NEW: Background scan status (spinner + message) -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="LibraryStatusRing"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryStatusText"
                           Opacity="0.75"
                           Text=""
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search films by name, file type, folder, or duration"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortByBox"
                          Grid.Column="1"
                          Header="Sort by"
                          SelectedIndex="0"
                          SelectionChanged="SortByBox_SelectionChanged"
                          MinWidth="180">
                    <ComboBoxItem Content="Recently added" Tag="recent"/>
                    <ComboBoxItem Content="Title A-Z" Tag="title-az"/>
                    <ComboBoxItem Content="Title Z-A" Tag="title-za"/>
                    <ComboBoxItem Content="Longest first" Tag="longest"/>
                    <ComboBoxItem Content="Shortest first" Tag="shortest"/>
                    <ComboBoxItem Content="File type" Tag="type"/>
                </ComboBox>
                <Button x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Content="Clear"
                        Click="ClearSearchButton_Click"/>
            </Grid>

            <TextBlock x:Name="SearchResultText"
                       Opacity="0.7"
                       FontSize="12"
                       Text=""/>
        </StackPanel>

        <!-- Thumbnails -->
        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind Videos, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.VerticalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ItemClick="GridView_ItemClick"
                  SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <!-- Each item -->
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="220" Spacing="8">
                        <Border CornerRadius="12" Height="330" Background="#202020">
                            <Grid>
                                <StackPanel Padding="18"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               FontSize="22"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               Opacity="0.55"
                                               FontSize="12"/>
                                </StackPanel>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReleaseDateText}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding DurationText}" Opacity="0.7" FontSize="12"/>

                        <!-- Button still here -->
                        <Button Content="Play with the Zink Video Player"
                                Click="PlayWithVideoPlayer_Click"
                                CommandParameter="{Binding}"/>
                        <Button Content="Learn about this film"
                                Click="LearnAboutFilm_Click"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        </Grid>

        <Grid x:Name="MovieLibraryLoadingOverlay"
              Background="#CC000000"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <ProgressRing x:Name="MovieLibraryLoadingRing"
                              Width="52"
                              Height="52"
                              IsActive="False"/>
                <TextBlock x:Name="MovieLibraryLoadingText"
                           Text="Loading films..."
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
