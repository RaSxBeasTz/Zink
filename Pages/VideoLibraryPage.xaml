<Page
    x:Class="Zink.Pages.VideoLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Zink.Pages"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="ScrollBarThumbFill" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="White"/>
    </Page.Resources>

    <Grid>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- Header + actions -->
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Video Library" FontSize="28" FontWeight="SemiBold" />
                <Button x:Name="AddFolderButton" Content="Add Folder" Click="AddFolderButton_Click" />
                <Button x:Name="AddMultipleFoldersButton"
                        Content="Add Multiple Folders"
                        Click="AddMultipleFoldersButton_Click"
                        ToolTipService.ToolTip="Choose up to 4 folders, one at a time" />
                <Button x:Name="RescanButton" Content="Rescan" Click="RescanButton_Click" />
            </StackPanel>

            <!-- ? NEW: Background scan status (spinner + message) -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="LibraryStatusRing"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              Visibility="Collapsed"/>
                <TextBlock x:Name="LibraryStatusText"
                           Opacity="0.75"
                           Text=""
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="LibraryStatusProgressBar"
                             Width="160"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="LibraryStatusProgressText"
                           Opacity="0.75"
                           Text=""
                           MinWidth="36"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search the films by the name, the file type, the folder, or the duration"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="SortByBox"
                          Grid.Column="1"
                          Header="Sort by"
                          SelectedIndex="0"
                          SelectionChanged="SortByBox_SelectionChanged"
                          MinWidth="180">
                    <ComboBoxItem Content="the Recently added" Tag="recent"/>
                    <ComboBoxItem Content="Title A-Z" Tag="title-az"/>
                    <ComboBoxItem Content="Title Z-A" Tag="title-za"/>
                    <ComboBoxItem Content="Longest first" Tag="longest"/>
                    <ComboBoxItem Content="Shortest first" Tag="shortest"/>
                    <ComboBoxItem Content="File type" Tag="type"/>
                </ComboBox>
                <Button x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Content="Clear"
                        Click="ClearSearchButton_Click"/>
            </Grid>

            <TextBlock x:Name="SearchResultText"
                       Opacity="0.7"
                       FontSize="12"
                       Text=""/>
        </StackPanel>

        <!-- Thumbnails -->
        <GridView x:Name="VideoGridView"
                  Grid.Row="1"
                  ItemsSource="{x:Bind Videos, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  ScrollViewer.VerticalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ItemClick="GridView_ItemClick"
                  ContainerContentChanging="VideoGridView_ContainerContentChanging"
                  SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="0"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <!-- Each item -->
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="220" Spacing="8">
                        <Border CornerRadius="12" Height="330" Background="#202020">
                            <Grid>
                                <StackPanel Padding="18"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               FontSize="22"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding FileName}"
                                               TextWrapping="WrapWholeWords"
                                               TextAlignment="Center"
                                               Opacity="0.55"
                                               FontSize="12"/>
                                </StackPanel>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReleaseDateText}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding DurationText}" Opacity="0.7" FontSize="12"/>

                        <!-- Button still here -->
                        <Button Content="Play with the Zink Video Player"
                                Click="PlayWithVideoPlayer_Click"
                                CommandParameter="{Binding}"/>
                        <Button Content="Learn about this film"
                                Click="LearnAboutFilm_Click"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        </Grid>

        <Grid x:Name="MovieLibraryLoadingOverlay"
              Background="#CC000000"
              Visibility="Collapsed">
            <Border MaxWidth="520"
                    Margin="24"
                    Padding="32,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F2040F16"
                    BorderBrush="#7A11D8E8"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="14">
                    <ProgressRing x:Name="MovieLibraryLoadingRing"
                                  Width="52"
                                  Height="52"
                                  IsActive="False"
                                  HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MovieLibraryLoadingText"
                               Text="Loading films..."
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               Foreground="#F4FFFFFF"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">
                        <ProgressBar x:Name="MovieLibraryLoadingProgressBar"
                                     Width="260"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="MovieLibraryLoadingPercentage"
                                   Text=""
                                   MinWidth="42"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#BDE7FFF6"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EmptyLibraryPromptOverlay"
              Background="#99000814"
              Visibility="Collapsed">
            <Border MaxWidth="760"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#F21F2223"
                    BorderBrush="#3F6F7B80"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Padding="34,32,34,30"
                                Spacing="18">
                        <TextBlock Text="Your video library is empty"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="#D7E9EC"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="This section is empty. Would you like to choose the folder where your videos are stored so Zink can keep them here for future use?"
                                   FontSize="20"
                                   LineHeight="29"
                                   Foreground="#BBCDD1"
                                   TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#E91A1D1E"
                            BorderBrush="#1F000000"
                            BorderThickness="0,1,0,0"
                            Padding="34,34,34,34">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="EmptyLibraryChooseFolderButton"
                                    Content="Choose folder"
                                    Click="EmptyLibraryChooseFolderButton_Click"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="52"
                                    FontSize="20"
                                    Foreground="#050909"
                                    Background="#6CD2D8"
                                    BorderThickness="0"/>
                            <Button x:Name="EmptyLibraryNotNowButton"
                                    Grid.Column="1"
                                    Content="Not now"
                                    Click="EmptyLibraryNotNowButton_Click"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="52"
                                    FontSize="20"
                                    Foreground="#BBCDD1"
                                    Background="#132B2F"
                                    BorderThickness="0"/>
                            <Button x:Name="EmptyLibraryDontAskAgainButton"
                                    Grid.Column="2"
                                    Content="Don't ask again"
                                    Click="EmptyLibraryDontAskAgainButton_Click"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="52"
                                    FontSize="20"
                                    Foreground="#BBCDD1"
                                    Background="#132B2F"
                                    BorderThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
