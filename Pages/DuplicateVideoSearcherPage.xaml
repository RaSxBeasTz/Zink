<Page
    x:Class="Zink.Pages.DuplicateVideoSearcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="Duplicate Video Searcher" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Find videos in your Zink Video Library that appear more than once." Opacity="0.75"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Top"/>
        </Grid>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="1"
                 IsOpen="False"/>

        <ListView x:Name="DuplicateGroupsList"
                  Grid.Row="2"
                  ItemsSource="{x:Bind DuplicateGroups, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,8,0,14" Spacing="10">
                        <Border CornerRadius="8"
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Opacity="0.72"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}"
                                                               Opacity="0.7"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Button Grid.Column="1"
                                                        Content="Play"
                                                        CommandParameter="{Binding}"
                                                        Click="PlayButton_Click"/>
                                                <Button Grid.Column="2"
                                                        Content="Open the file location"
                                                        CommandParameter="{Binding}"
                                                        Click="OpenFileLocationButton_Click"/>
                                                <Button Grid.Column="3"
                                                        Content="Delete"
                                                        CommandParameter="{Binding}"
                                                        Click="DeleteButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

        <Grid x:Name="ZinkDialogOverlay"
              Background="#9900060C"
              Visibility="Collapsed">
            <Border Width="520"
                    MaxWidth="720"
                    Padding="24"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource ZinkGlassPanelBrush}"
                    BorderBrush="{StaticResource ZinkGlassBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46"
                                Height="46"
                                CornerRadius="23"
                                Background="#2438FF66">
                            <FontIcon x:Name="ZinkDialogIcon"
                                      Glyph="&#xE74D;"
                                      FontFamily="Segoe Fluent Icons"
                                      FontSize="20"
                                      Foreground="#38FF66"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="ZinkDialogTitle"
                                       Text="Are you sure you want to delete the video file?"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ZinkDialogMessage"
                                       Opacity="0.78"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right">
                        <Button x:Name="ZinkDialogCancelButton"
                                Content="Cancel"
                                Click="ZinkDialogCancelButton_Click"/>
                        <Button x:Name="ZinkDialogPrimaryButton"
                                Content="Delete"
                                Click="ZinkDialogPrimaryButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
