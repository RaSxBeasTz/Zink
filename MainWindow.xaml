            </Image>

            <Border Width="88"
                    Height="88"
                    Margin="0,0,0,88"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    CornerRadius="44"
                    BorderBrush="#A838FF66"
                    BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="#7600040A"/>
                </Border.Background>

                <ProgressRing IsActive="True"
                              Width="52"
