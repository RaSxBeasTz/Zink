                        Background="Transparent"
                        BorderBrush="Transparent"
                        Width="56"
                        Height="48"
                        HorizontalAlignment="Left"
                        Margin="4,6,0,10">
                    <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons"/>
                </Button>
            </NavigationView.PaneHeader>

