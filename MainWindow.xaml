<Window 
    x:Class="Zink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zink"
    Title="Zink">

    <Grid x:Name="RootGrid">

        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewPaneBorderBrush" Color="#00FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>

            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#2E11D8E8"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#4038FF66"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#3838FF66"/>
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F4FFFFFF"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#38FF66"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForeground" Color="#BDE7FFF6"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundPointerOver" Color="White"/>
            <SolidColorBrush x:Key="NavigationViewItemIconForegroundSelected" Color="#38FF66"/>
            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#BDE7FFF6"/>
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="#8A38FF66"/>
            <Style TargetType="FontIcon">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Foreground" Value="{StaticResource NavigationViewItemIconForeground}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="BitmapIcon">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Resources>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="ShellGradientStart" Color="#DE000814" Offset="0"/>
                <GradientStop x:Name="ShellGradientMiddle" Color="#A0062D38" Offset="0.52"/>
                <GradientStop x:Name="ShellGradientEnd" Color="#7606404A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.ColumnSpan="2"
               Stretch="UniformToFill"
               Opacity="0.46"
               IsHitTestVisible="False">
            <Image.Source>
                <BitmapImage UriSource="ms-appx:///Assets/ZinkGeneratedThemeBackground.png"
                             DecodePixelWidth="1920"/>
            </Image.Source>
        </Image>

        <Rectangle Grid.ColumnSpan="2"
                   Fill="#6400040A"
                   IsHitTestVisible="False"/>

        <Border x:Name="SidebarGlassHost"
                Grid.Column="0"
                Margin="12"
                Padding="6"
                CornerRadius="28"
                Background="{StaticResource ZinkGlassPanelBrush}"
                BorderBrush="{StaticResource ZinkGlassBorderBrush}"
                BorderThickness="1">
