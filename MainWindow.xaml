            x:Name="SidebarNav"
            x:FieldModifier="public"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            PaneTitle=""
            OpenPaneLength="292"
            CompactPaneLength="76"
            Background="Transparent"
            IsSettingsVisible="False"
            PaneOpening="SidebarNav_PaneOpening"
            PaneOpened="SidebarNav_PaneOpened"
            PaneClosing="SidebarNav_PaneClosing"
            PaneClosed="SidebarNav_PaneClosed"
            SelectionChanged="SidebarNav_SelectionChanged">

            <NavigationView.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="TextTrimming" Value="None"/>
                </Style>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Button x:Name="SidebarToggleButton"
