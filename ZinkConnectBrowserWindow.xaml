<Window
    x:Class="Zink.ZinkConnectBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:wv2="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="Root" Background="#101820">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="36"/>
            <RowDefinition x:Name="TabsRow" Height="40"/>
            <RowDefinition x:Name="ToolbarRow" Height="54"/>
            <RowDefinition x:Name="FavoritesRow" Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusRow" Height="32"/>
        </Grid.RowDefinitions>

        <Grid x:Name="BrowserTitleBar" Grid.Row="0" Padding="12,0,148,0">
            <Grid.Background>
                <AcrylicBrush TintColor="#102534"
                              TintOpacity="0.78"
                              FallbackColor="#102534"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="22"
                    Height="22"
                    CornerRadius="7"
                    Background="#263FE7F4"
                    BorderBrush="#594DE8F4"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE774;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="12"
                          Foreground="#EAFBFF"/>
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="9,0,0,0"
                        Orientation="Horizontal"
                        Spacing="7"
                        VerticalAlignment="Center">
                <TextBlock Text="Zink Connect"
                           Foreground="#F2FBFF"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <Border Width="1" Height="12" Background="#3DFFFFFF"/>
                <TextBlock Text="Browser"
                           Foreground="#9FC8D8E2"
                           FontSize="11"/>
            </StackPanel>
            <Border Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="#334DE8F4"/>
        </Grid>

        <Grid Grid.Row="1" Background="#151F29">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:TabView x:Name="BrowserTabs"
                              Grid.Column="0"
                              SelectionChanged="BrowserTabs_SelectionChanged"
                              TabCloseRequested="BrowserTabs_TabCloseRequested"
                              CanDragTabs="True"
                              CanReorderTabs="True"
                              IsAddTabButtonVisible="False">
                <controls:TabView.TabStripFooter>
                    <Button x:Name="NewTabButton"
                            Width="38"
                            Height="32"
                            Margin="4,4,4,4"
                            Padding="0"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="#35FFFFFF"
                            Click="NewTabButton_Click"
                            ToolTipService.ToolTip="New tab">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                    </Button>
                </controls:TabView.TabStripFooter>
            </controls:TabView>

            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Width="38"
                    Height="32"
                    Margin="0,4,8,4"
                    Padding="0"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="#35FFFFFF"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Padding="10,7" ColumnSpacing="8" Background="#151F29">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Width="40" Height="40" Padding="0" Click="BackButton_Click" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Width="40" Height="40" Padding="0" Click="ForwardButton_Click" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="2" Width="40" Height="40" Padding="0" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>
            <Button Grid.Column="3" Width="40" Height="40" Padding="0" Click="HomeButton_Click" ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>

            <TextBox x:Name="AddressBox"
                     Grid.Column="4"
                     Height="40"
                     CornerRadius="18"
                     PlaceholderText="Search or enter web address"
                     KeyDown="AddressBox_KeyDown"/>

            <Button Grid.Column="5" Width="40" Height="40" Padding="0" Click="GoButton_Click" ToolTipService.ToolTip="Go">
                <FontIcon Glyph="&#xE8AD;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>

            <Button x:Name="HistoryButton" Grid.Column="6" Width="40" Height="40" Padding="0" Click="HistoryButton_Click" ToolTipService.ToolTip="History">
                <FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
            </Button>
        </Grid>

        <Grid Grid.Row="3" Background="#101820" Padding="10,5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="112"
                    Height="32"
                    Padding="12,0"
                    Tag="https://www.youtube.com/"
                    Click="FavoriteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    <TextBlock Text="YouTube"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1"
                    MinWidth="108"
                    Height="32"
                    Padding="12,0"
                    Tag="https://outlook.com/"
                    Click="FavoriteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE715;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    <TextBlock Text="Outlook"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2"
                    MinWidth="96"
                    Height="32"
                    Padding="12,0"
                    Tag="https://www.twitch.tv/"
                    Click="FavoriteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                    <TextBlock Text="Twitch"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="4" Background="#080C10">
            <Grid x:Name="BrowserHost"/>

            <Grid x:Name="SettingsPage"
                  Visibility="Collapsed"
                  Background="#101820"
                  Padding="34">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ViewChanged="SettingsScrollViewer_ViewChanged"
                                  SizeChanged="SettingsScrollViewer_SizeChanged">
                        <StackPanel MaxWidth="760" Spacing="24" HorizontalAlignment="Left">
                        <TextBlock Text="Zink Connect Settings"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="SemiBold"/>
                        <Border Background="#182633" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Launch Zink browser only"
                                               Foreground="White"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="When Zink Connect is clicked in the sidebar, open this browser and send the main Zink window to the tray."
                                               Foreground="#B8D8E7F2"
                                               TextWrapping="WrapWholeWords"
                                               FontSize="13"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LaunchBrowserOnlyToggle"
                                              Grid.Column="1"
                                              MinWidth="100"
                                              Toggled="LaunchBrowserOnlyToggle_Toggled"/>
                            </Grid>
                        </Border>

                    <Border Background="#182633" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Enable browsing history"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Save Zink Connect browsing history so it is available after app restarts, updates, and reinstalls when local app data is kept."
                                           Foreground="#B8D8E7F2"
                                           TextWrapping="WrapWholeWords"
                                           FontSize="13"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="BrowsingHistoryToggle"
                                          Grid.Column="1"
                                          MinWidth="100"
                                          Toggled="BrowsingHistoryToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <Border Background="#182633" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Remember website sign-ins and cookie preferences"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Keep Zink Connect website sessions, saved sign-in data, cookies, and site preferences available after app restarts, updates, and reinstalls when local app data is kept."
                                           Foreground="#B8D8E7F2"
                                           TextWrapping="WrapWholeWords"
                                           FontSize="13"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="RememberSignInAndCookiePreferencesToggle"
                                          Grid.Column="1"
                                          MinWidth="100"
                                          Toggled="RememberSignInAndCookiePreferencesToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <Border Background="#182633" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Delete all browsing data on each app close"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Automatically wipe Zink Connect history, cookies, cache, site storage, saved passwords, autofill, downloads history, and service worker data when the browser closes."
                                           Foreground="#B8D8E7F2"
                                           TextWrapping="WrapWholeWords"
                                           FontSize="13"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="DeleteBrowsingDataOnCloseToggle"
                                          Grid.Column="1"
                                          MinWidth="100"
                                          Toggled="DeleteBrowsingDataOnCloseToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <Border Background="#182633" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Clear all browsing data"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Wipe Zink Connect history, cookies, cache, site storage, saved passwords, autofill, downloads history, and service worker data."
                                           Foreground="#B8D8E7F2"
                                           TextWrapping="WrapWholeWords"
                                           FontSize="13"/>
                            </StackPanel>
                            <Button x:Name="ClearBrowsingDataButton"
                                    Grid.Column="1"
                                    MinWidth="150"
                                    Height="36"
                                    Padding="14,0"
                                    Background="#8A2730"
                                    Foreground="White"
                                    BorderBrush="#55FFFFFF"
                                    Click="ClearBrowsingDataButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                                    <TextBlock Text="Clear data"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <primitives:ScrollBar x:Name="SettingsScrollBar"
                                          Grid.Column="1"
                                          Width="12"
                                          Orientation="Vertical"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Stretch"
                                          Minimum="0"
                                          SmallChange="48"
                                          LargeChange="240"
                                          Background="#33000000"
                                          Foreground="White"
                                          ValueChanged="SettingsScrollBar_ValueChanged">
                        <primitives:ScrollBar.Resources>
                            <SolidColorBrush x:Key="ScrollBarThumbFill" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="#66FFFFFF"/>
                            <SolidColorBrush x:Key="ScrollBarPanningThumbFill" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarPanningThumbFillPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarPanningThumbFillPressed" Color="White"/>
                            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#22000000"/>
                            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#33000000"/>
                        </primitives:ScrollBar.Resources>
                    </primitives:ScrollBar>
                </Grid>
            </Grid>

            <Grid x:Name="HistoryPage"
                  Visibility="Collapsed"
                  Background="#101820"
                  Padding="34">
                <StackPanel MaxWidth="860" Spacing="18" HorizontalAlignment="Left">
                    <TextBlock Text="Browsing History"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="HistoryHintText"
                               Text="Your Zink Connect history appears here."
                               Foreground="#B8D8E7F2"
                               FontSize="13"
                               TextWrapping="WrapWholeWords"/>
                    <ListView x:Name="HistoryList"
                              MinHeight="360"
                              MaxHeight="620"
                              Background="#182633"
                              BorderBrush="#35FFFFFF"
                              BorderThickness="1"
                              CornerRadius="8"
                              IsItemClickEnabled="True"
                              ItemClick="HistoryList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,10" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Url}"
                                               Foreground="#B8D8E7F2"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding VisitedText}"
                                               Foreground="#8CB7C8D8"
                                               FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Padding="12,0" Background="#151F29">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       Foreground="#CFE8F3"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
